          text: "                                        val dist = hypot(pt.x - touchXNorm, pt.y - touchYNorm)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                                        if (dist < minDist) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
