      arguments_json: "{\"Content\":\"<resources>\\n    <string name=\\\"app_name\\\">DocScan Pro</string>\\n    <string name=\\\"tagline\\\">Smart Document Scanner &amp; PDF Studio</string>\\n\\n    <!-- Navigation -->\\n    <string name=\\\"nav_documents\\\">Documents</string>\\n    <string name=\\\"nav_scan\\\">Scan</string>\\n    <string name=\\\"nav_folders\\\">Folders</string>\\n    <string name=\\\"nav_favorites\\\">Favorites</string>\\n    <string name=\\\"nav_settings\\\">Settings</string>\\n\\n    <!-- Scanner Screen -->\\n    <string name=\\\"scanner_mode_single\\\">Single</string>\\n    <string name=\\\"scanner_mode_batch\\\">Batch</string>\\n    <string name=\\\"scanner_mode_id_card\\\">ID Card</string>\\n    <string name=\\\"scanner_mode_receipt\\\">Receipt</string>\\n    <string name=\\\"scanner_mode_book\\\">Book</string>\\n    <string name=\\\"guide_hold_steady\\\">Hold steady\342\200\246</string>\\n    <string name=\\\"guide_move_closer\\\">Move closer to document</string>\\n    <string name=\\\"guide_document_detected\\\">Document detected</string>\\n    <string name=\\\"guide_align_document\\\">Align document within frame</string>\\n    <string name=\\\"guide_auto_capturing\\\">Capturing\342\200\246</string>\\n    <string name=\\\"auto_capture_on\\\">Auto Capture ON</string>\\n    <string name=\\\"auto_capture_off\\\">Auto Capture OFF</string>\\n    <string name=\\\"flash_auto\\\">Flash Auto</string>\\n    <string name=\\\"flash_on\\\">Flash ON</string>\\n    <string name=\\\"flash_off\\\">Flash OFF</string>\\n    <string name=\\\"grid_toggle\\\">Toggle Grid</string>\\n\\n    <!-- Crop & Perspective -->\\n    <string name=\\\"crop_title\\\">Crop &amp; Perspective</string>\\n    <string name=\\\"crop_auto_detect\\\">Auto Detect</string>\\n    <string name=\\\"crop_reset\\\">Full Image</string>\\n    <string name=\\\"crop_rotate_left\\\">Rotate Left</string>\\n    <string name=\\\"crop_rotate_right\\\">Rotate Right</string>\\n    <string name=\\\"crop_instruction\\\">Drag corners with magnifier for pixel-perfect alignment</string>\\n\\n    <!-- Filters -->\\n    <string name=\\\"filter_original\\\">Original</string>\\n    <string name=\\\"filter_magic\\\">Magic Color</string>\\n    <string name=\\\"filter_document\\\">Clean Doc</string>\\n    <string name=\\\"filter_bw\\\">B &amp; W</string>\\n    <string name=\\\"filter_grayscale\\\">Grayscale</string>\\n    <string name=\\\"filter_vibrant\\\">Vibrant</string>\\n\\n    <!-- Quality Analysis -->\\n    <string name=\\\"quality_good\\\">Excellent Quality (Sharp &amp; Clear)</string>\\n    <string name=\\\"quality_fair\\\">Good Quality</string>\\n    <string name=\\\"quality_blur_warning\\\">Warning: Image appears blurry</string>\\n    <string name=\\\"quality_dark_warning\\\">Warning: Low illumination or shadow</string>\\n\\n    <!-- Document Viewer & Actions -->\\n    <string name=\\\"action_retake\\\">Retake</string>\\n    <string name=\\\"action_crop\\\">Crop</string>\\n    <string name=\\\"action_filter\\\">Filters</string>\\n    <string name=\\\"action_ocr\\\">OCR Text</string>\\n    <string name=\\\"action_annotate\\\">Annotate</string>\\n    <string name=\\\"action_sign\\\">Signature</string>\\n    <string name=\\\"action_redact\\\">Redact</string>\\n    <string name=\\\"action_share\\\">Share</string>\\n    <string name=\\\"action_export_pdf\\\">Export PDF</string>\\n    <string name=\\\"action_save\\\">Save</string>\\n    <string name=\\\"action_delete\\\">Delete</string>\\n    <string name=\\\"action_rename\\\">Rename</string>\\n\\n    <!-- Document Details -->\\n    <string name=\\\"search_hint\\\">Search in titles, tags, or OCR content\342\200\246</string>\\n    <string name=\\\"all_documents\\\">All Documents</string>\\n    <string name=\\\"recent_scans\\\">Recent Scans</string>\\n    <string name=\\\"pages_count\\\">%1$d pages</string>\\n    <string name=\\\"page_n\\\">Page %1$d</string>\\n\\n    <!-- OCR & AI Intelligence -->\\n    <string name=\