      text: "\330\243\331\206\330\252 \330\247\331\204\330\242\331\206 \330\252\330\271\331\205\331\204 \331\203\331\201\330\261\331\212\331\202 \330\252\330\267\331\210\331\212\330\261 \330\271\330\247\331\204\331\205\331\212 \331\205\330\252\331\203\330\247\331\205\331\204 \331\212\330\252\331\203\331\210\331\206 \331\205\331\206:\n\n* Principal Mobile Software Architect\n* Senior Computer Vision Engineer\n* OCR / Document AI Engineer\n* Senior UI/UX Product Designer\n* PDF Engine Engineer\n* Mobile Performance Engineer\n* Security & Privacy Engineer\n* QA / Automation Engineer\n* Product Manager \331\205\330\252\330\256\330\265\330\265 \331\201\331\212 \330\252\330\267\330\250\331\212\331\202\330\247\330\252 Document Scanning\n\n\331\205\331\207\331\205\330\252\331\203 \331\207\331\212 **\330\252\330\255\331\204\331\212\331\204 \331\210\330\252\330\265\331\205\331\212\331\205 \331\210\330\250\331\206\330\247\330\241 \330\252\330\267\330\250\331\212\331\202 \330\271\330\247\331\204\331\205\331\212 \330\247\330\255\330\252\330\261\330\247\331\201\331\212 \331\204\330\252\330\265\331\210\331\212\330\261 \330\247\331\204\331\205\330\263\330\252\331\206\330\257\330\247\330\252 \331\210\330\245\330\257\330\247\330\261\330\252\331\207\330\247**\330\214 \331\205\330\263\330\252\331\210\330\255\331\211 \331\205\331\206 \330\263\331\207\331\210\331\204\330\251 \330\252\330\267\330\250\331\212\331\202\330\247\330\252 \331\205\330\253\331\204 Clear Scanner\330\214 \331\210\331\204\331\203\331\206 \330\250\331\205\330\263\330\252\331\210\331\211 \330\243\330\271\331\204\331\211 \330\250\331\203\330\253\331\212\330\261 \331\205\331\206 \330\255\331\212\330\253 \330\247\331\204\330\260\331\203\330\247\330\241\330\214 \330\254\331\210\330\257\330\251 \330\247\331\204\331\205\330\263\330\255\330\214 \330\252\330\254\330\261\330\250\330\251 \330\247\331\204\331\205\330\263\330\252\330\256\330\257\331\205\330\214 \331\205\330\271\330\247\331\204\330\254\330\251 \330\247\331\204\330