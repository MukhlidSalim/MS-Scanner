\330\261\330\250 \331\205\331\206 \330\247\331\204\331\205\330\263\330\252\331\206\330\257</string>\n    <string name=\"guide_document_detected\">\330\252\331\205 \330\247\331\203\330\252\330\264\330\247\331\201 \330\247\331\204\331\205\330\263\330\252\331\206\330\257</string>\n    <string name=\"guide_align_document\">\331\210\330\254\331\221\331\207 \330\247\331\204\331\203\330\247\331\205\331\212\330\261\330\247 \331\206\330\255\331\210 \330\255\330\257\331\210\330\257 \330\247\331\204\331\205\330\263\330\252\331\206\330\257</string>\n    <string name=\"guide_auto_capturing\">\330\254\330\247\330\261\331\212 \330\247\331\204\330\247\331\204\330\252\331\202\330\247\330\267 \330\247\331\204\330\252\331\204\331\202\330\247\330\246\331\212\342\200\246</string>\n    <string name=\"auto_capture_on\">\330\247\331\204\330\247\331\204\330\252\331\202\330\247\330\267 \330\247\331\204\330\252\331\204\331\202\330\247\330\246\331\212 \331\205\331\201\330\271\331\221\331\204</string>\n    <string name=\"auto_capture_off\">\330\247\331\204\330\247\331\204\330\252\331\202\330\247\330\267 \330\247\331\204\330\252\331\204\331\202\330\247\330\246\331\212 \331\205\330\252\331\210\331\202\331\201</string>\n    <string name=\"flash_auto\">\331\201\331\204\330\247\330\264 \330\252\331\204\331\202\330\247\330\246\331\212</string>\n    <string name=\"flash_on\">\330\252\330\264\330\272\331\212\331\204 \330\247\331\204\331\201\331\204\330\247\330\264</string>\n    <string name=\"flash_off\">\330\245\331\212\331\202\330\247\331\201 \330\247\331\204\331\201\331\204\330\247\330\264</string>\n    <string name=\"grid_toggle\">\330\245\330\270\331\207\330\247\330\261 \330\247\331\204\330\264\330\250\331\203\330\251</string>\n\n    <!-- Crop & Perspective -->\n    <string name=\"crop_title\">\330\247\331\204\331\202\330\265 \331\210\330\266\330\250\330\267 \330\247\331\204\331\205\331\206\330\270\331\210\330\261</string>\n    <string name=\"crop_auto_detect\">\330\247\331\203\330\252\330\264\330\247\331\201 \330\252\331\204\331\202\330\247\330\246\331\212</string>\n    <string name=\"crop_reset\">\331\203\330\247\331\205\331\204 \330\247\331\204\330\265\331\210\330\261\330\251</string>\n    <string name=\"crop_rotate_left\">\330\252\330\257\331\210\331\212\330\261 \331\204\331\204\331\212\330\263\330\247\330\261</string>\n    <string name=\"crop_rotate_right\">\330\252\330\257\331\210\331\212\330\261 \331\204\331\204\331\212\331\205\331\212\331\206</string>\n    <string name=\"crop_instruction\">\330\247\330\263\330\255\330\250 \330\247\331\204\330\262\331\210\330\247\331\212\330\247 \330\250\330\257\331\202\330\251 \330\250\331\210\330\247\330\263\330\267\330\251 \330\247\331\204\330\271\330\257\330\263\330\251 \330\247\331\204\331\205\331\203\330\250\330\261\330\251</string>\n\n    <!-- Filters -->\n    <string name=\"filter_original\">\330\247\331\204\330\243\330\265\331\204\331\212\330\251</string>\n    <string name=\"filter_magic\">\330\243\331\204\331\210\330\247\331\206 \330\263\330\255\330\261\331\212\330\251</string>\n    <string name=\"filter_document\">\331\205\330\263\330\252\331\206\330\257 \331\206\331\202\331\212</string>\n    <string name=\"filter_bw\">\330\243\330\250\331\212\330\266 \331\210\330\243\330\263\331\210\330\257</string>\n    <string name=\"filter_grayscale\">\330\252\330\257\330\261\330\254 \330\261\331\205\330\247\330\257\331\212</string>\n    <string name=\"filter_vibrant\">\330\255\331\212\331\210\331\212\330\251 \331\205\330\271\330\262\330\262\330\251</string>\n\n    <!-- Quality Analysis -->\n    <string name=\"quality_good\">\330\254\331\210\330\257\330\251 \331\205\331\205\330\252\330\247\330\262\330\251 (\331\210\330\247\330\266\330\255\330\251 \331\210\331\206\331\202\331\212\330\251)</string>\n    <string name=\"quality_fair\">\330\254\331\210\330\257\330\251 \331\205\331\202\330\250\331\210\331\204\330\251</string>\n    <string name=\"quality_blur_warning\">\330\252\331\206\330\250\331\212\331\207: \330\247\331\204\330\265\331\210\330\261\330\251 \331\202\330\257 \330\252\331\203\331\210\331\206 \330\266\330\250\330\247\330\250\331\212\330\251 \330\243\331\210 \331\205\331\207\330\252\330\262\330\251</string>\n    <string name=\"quality_dark_warning\">\330\252\331\206\330\250\331\212\331\207: \330\245\330\266\330\247\330\241\330\251 \331\205\331\206\330\256\331\201\330\266\330\251 \330\243\331\210 \331\210\330\254\331\210\330\257 \330\270\331\204\330\247\331\204</string>\n\n    <!-- Document Viewer & Actions -->\n    <string name=\"action_retake\">\330\245\330\271\330\247\330\257\330\251 \330\252\330\265\331\210\331\212\330\261</string>\n    <string name=\"action_crop\">\331\202\330\265 \331\210\330\266\330\250\330\267</string>\n    <string name=\"action_filter\">\331\201\331\204\330\247\330\252\330\261</string>\n    <string name=\"action_ocr\">\330\247\330\263\330\252\330\256\330\261\330\247\330\254 \330\247\331\204\331\206\330\265 (OCR)</string>\n    <string name=\"action_annotate\">\330\261\330\263\331\205 \331\210\330\252\330\271\331\204\331\212\331\202</string>\n    <string name=\"action_sign\">\330\252\331\210\331\202\331\212\330\271 \330\245\331\204\331\203\330\252\330\261\331\210\331\206\331\212</string>\n    <string name=\"action_redact\">\330\252\330\271\330\252\331\212\331\205 \331\210\330\255\330\254\330\250 \330\243\331\205\331\206\331\212</string>\n    <string name=\"action_share\">\331\205\330\264\330\247\330\261\331\203\330\251</string>\n    <string name=\"action_export_pdf\">\330\252\330\265\330\257\331\212\330\261 PDF</string>\n    <string name=\"action_save\">\330\255\331\201\330\270</string>\n    <string name=\"action_delete\">\330\255\330\260\331\201</string>\n    <string name=\"action_rename\">\330\245\330\271\330\247\330\257\330\251 \330\252\330\263\331\205\331\212\330\251</string>\n\n    <!-- Document Details -->\n    <string name=\"search_hint\">\330\247\330\250\330\255\330\253 \331\201\331\212 \330\247\331\204\330\271\331\206\330\247\331\210\331\212\331\206 \330\243\331\210 \330\247\331\204\331\210\330\263\331\210\331\205 \330\243\331\210 \331\206\330\265\331\210\330\265 OCR\342\200\246</string>\n    <string name=\"all_documents\">\330\254\331\205\331\212\330\271 \330\247\331\204\331\205\330\263\330\252\331\206\330\257\330\247\330\252</string>\n    <string name=\"recent_scans\">\330\243\330\255\330\257\330\253 \330\247\331\204\331\205\330\263\331\210\330\255\330\247\330\252</string>\n    <string name=\"pages_count\">%1$d \330\265\331\201\330\255\330\247\330\252</string>\n    <string name=\"page_n\">\330\265\331\201\330\255\330\251 %1$d</string>\n\n    <!-- OCR & AI Intelligence -->\n    <string name=\"ocr_extracting\">\330\254\330\247\330\261\331\212 \330\252\330\255\331\204\331\212\331\204 \330\247\331\204\331\205\330\263\330\252\331\206\330\257 \331\210\330\247\330\263\330\252\330\256\330\261\330\247\330\254 \330\247\331\204\331\206\330\265\331\210\330\265 \330\250\330\257\331\202\330\251\342\200\246</string>\n    <string name=\"ocr_copy_all\">\331\206\330\263\330\256 \330\247\331\204\331\206\330\265 \330\250\330\247\331\204\331\203\330\247\331\205\331\204</string>\n    <string name=\"ocr_share_text\">\331\205\330\264\330\247\330\261\331\203\330\251 \330\247\331\204\331\206\330\265</string>\n    <string name=\"ocr_ai_intelligence\">\330\252\330\255\331\204\331\212\331\204 \330\247\331\204\330\260\331\203\330\247\330\241 \330\247\331\204\330\247\330\265\330\267\331\206\330\247\330\271\331\212 \331\204\331\204\331\205\330\263\330\252\331\206\330\257</string>\n    <string name=\"ai_classify\">\330\252\330\265\331\206\331\212\331\201 \330\252\331\204\331\202\330\247\330\246\331\212 \331\204\331\204\331\205\330\263\330\252\331\206\330\257</string>\n\n    <!-- PDF Settings -->\n    <string name=\"pdf_settings_title\">\330\245\330\271\330\257\330\247\330\257\330\247\330\252 \330\252\330\265\330\257\331\212\330\261 PDF</string>\n    <string name=\"page_size_a4\">A4 (\331\202\331\212\330\247\330\263\331\212)</string>\n    <string name=\"page_size_letter\">US Letter (\330\243\331\205\330\261\331\212\331\203\331\212)</string>\n    <string name=\"page_size_fit\">\330\255\330\263\330\250 \330\255\330\254\331\205 \330\247\331\204\330\265\331\210\330\261\330\251</string>\n    <string name=\"compression_max\">\330\243\330\271\331\204\331\211 \330\254\331\210\330\257\330\251 (\330\250\330\257\331\210\331\206 \330\266\330\272\330\267)</string>\n    <string name=\"compression_high\">\330\254\331\210\330\257\330\251 \330\271\330\247\331\204\331\212\330\251 (\331\205\330\252\331\210\330\247\330\262\331\206)</string>\n    <string name=\"compression_medium\">\331\205\330\252\331\210\330\263\330\267 (\330\255\330\254\331\205 \331\205\331\204\331\201 \330\265\330\272\331\212\330\261)</string>\n    <string name=\"compression_low\">\331\205\331\206\330\256\331\201\330\266 (\330\263\330\261\331\212\330\271 \331\204\331\204\331\205\330\261\330\247\330\263\331\204\330\251)</string>\n\n    <!-- Privacy & Security -->\n    <string name=\"privacy_title\">\330\247\331\204\330\256\330\265\331\210\330\265\331\212\330\251 \331\210\330\247\331\204\330\243\331\205\330\247\331\206</string>\n    <string name=\"privacy_offline_notice\">\330\243\331\210\331\201\331\204\330\247\331\212\331\206 100%. \331\205\330\263\330\252\331\206\330\257\330\247\330\252\331\203 \331\210\330\250\331\212\330\247\331\206\330\247\330\252\331\203 \331\205\330\255\331\201\331\210\330\270\330\251 \331\205\330\255\331\204\331\212\330\247\331\213 \330\250\330\247\331\204\331\203\330\247\331\205\331\204 \330\271\331\204\331\211 \331\207\330\247\330\252\331\201\331\203 \330\257\331\210\331\206 \331\205\330\264\330\247\330\261\331\203\330\251 \330\256\330\247\330\261\330\254 \330\254\331\207\330\247\330\262\331\203.</string>\n    <string name=\"app_lock\">\331\202\331\201\331\204 \330\247\331\204\330\252\330\267\330\250\331\212\331\202 \330\250\330\261\331\205\330\262 PIN</string>\n    <string name=\"pin_prompt\">\330\243\330\257\330\256\331\204 \330\261\331\205\330\262 PIN \330\247\331\204\331\205\331\203\331\210\331\206 \331\205\331\206 4 \330\243\330\261\331\202\330\247\331\205</string>\n    <string name=\"pin_set\">\330\252\330\271\331\212\331\212\331\206 \330\261\331\205\330\262 PIN \330\254\330\257\331\212\330\257</string>\n\n    <!-- Storage -->\n    <string name=\"storage_manager\">\330\245\330\257\330\247\330\261\330\251 \330\263\330\271\330\251 \330\247\331\204\330\252\330\256\330\262\331\212\331\206</string>\n    <string name=\"clear_cache\">\330\252\331\206\330\270\331\212\331\201 \330\247\331\204\330\260\330\247\331\203\330\261\330\251 \330\247\331\204\331\205\330\244\331\202\330\252\330\251</string>\n    <string name=\"empty_trash\">\330\245\331\201\330\261\330\247\330\272 \330\263\331\204\330\251 \330\247\331\204\331\205\330\255\330\260\331\210\331\201\330\247\330\252</string>\n</resources>\n"
