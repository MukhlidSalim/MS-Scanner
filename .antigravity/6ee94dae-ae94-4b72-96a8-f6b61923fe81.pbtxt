ity_fair\\\">\330\254\331\210\330\257\330\251 \331\205\331\202\330\250\331\210\331\204\330\251</string>\\n    <string name=\\\"quality_blur_warning\\\">\330\252\331\206\330\250\331\212\331\207: \330\247\331\204\330\265\331\210\330\261\330\251 \331\202\330\257 \330\252\331\203\331\210\331\206 \330\266\330\250\330\247\330\250\331\212\330\251 \330\243\331\210 \331\205\331\207\330\252\330\262\330\251</string>\\n    <string name=\\\"quality_dark_warning\\\">\330\252\331\206\330\250\331\212\331\207: \330\245\330\266\330\247\330\241\330\251 \331\205\331\206\330\256\331\201\330\266\330\251 \330\243\331\210 \331\210\330\254\331\210\330\257 \330\270\331\204\330\247\331\204</string>\\n\\n    <!-- Document Viewer & Actions -->\\n    <string name=\\\"action_retake\\\">\330\245\330\271\330\247\330\257\330\251 \330\252\330\265\331\210\331\212\330\261</string>\\n    <string name=\\\"action_crop\\\">\331\202\330\265 \331\210\330\266\330\250\330\267</string>\\n    <string name=\\\"action_filter\\\">\331\201\331\204\330\247\330\252\330\261</string>\\n    <string name=\\\"action_ocr\\\">\330\247\330\263\330\252\330\256\330\261\330\247\330\254 \330\247\331\204\331\206\330\265 (OCR)</string>\\n    <string name=\\\"action_annotate\\\">\330\261\330\263\331\205 \331\210\330\252\330\271\331\204\331\212\331\202</string>\\n    <string name=\\\"action_sign\\\">\330\252\331\210\331\202\331\212\330\271 \330\245\331\204\331\203\330\252\330\261\331\210\331\206\331\212</string>\\n    <string name=\\\"action_redact\\\">\330\252\330\271\330\252\331\212\331\205 \331\210\330\255\330\254\330\250 \330\243\331\205\331\206\331\212</string>\\n    <string name=\\\"action_share\\\">\331\205\330\264\330\247\330\261\331\203\330\251</string>\\n    <string name=\\\"action_export_pdf\\\">\330\252\330\265\330\257\331\212\330\261 PDF</string>\\n    <string name=\\\"action_save\\\">\330\255\331\201\330\270</string>\\n    <string name=\\\"action_delete\\\">\330\255\330\260\331\201</string>\\n    <string name=\\\"action