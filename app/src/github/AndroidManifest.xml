<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- In-app updater (GitHub distribution, in-place updates). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: required for PackageInstaller USER_ACTION_NOT_REQUIRED (UpdateInstaller) to take effect;
         without it every in-place update still asks for confirmation. Normal permission, granted at install. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <!-- PackageInstaller session results (in-place self update). Not exported. -->
        <receiver
            android:name=".engine.updater.UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
