<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+).
  Scanned documents (IDs, passports, contracts) are NOT uploaded to Google Drive auto-backup:
  images are large (the 25 MB quota would stop every backup) and a database without its images would
  restore as broken documents. Users move their documents with the in-app Backup / Restore (ZIP).
  Device-to-device transfer (local, cable/Wi-Fi, no size limit) keeps everything consistent.
  The PIN hash and lock state are never transferred to another device.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="database" path="docscan_master.db" />
        <exclude domain="database" path="docscan_master.db-shm" />
        <exclude domain="database" path="docscan_master.db-wal" />
        <exclude domain="database" path="docscan_master.db-journal" />
        <exclude domain="file" path="scans" />
        <exclude domain="file" path="exports" />
        <exclude domain="sharedpref" path="app_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="exports" />
        <exclude domain="sharedpref" path="app_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
